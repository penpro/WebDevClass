# Copy this file to `.env` on the EC2 server and fill in real values.
# Never commit the real .env. It is excluded via .gitignore.

# ---- MySQL ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hello_user
DB_PASSWORD=ChangeThisPassword123!
DB_NAME=hello_app

# ---- Sessions -------------------------------------------------------------
# Used to sign the session cookie. Must be a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Set to `true` once the site is served over HTTPS. Keeps the session cookie
# from being sent over plain HTTP. Leave as `false` during HTTP-only testing.
COOKIE_SECURE=false

# ---- Public URL -----------------------------------------------------------
# Used when building links that get emailed to users (password reset, etc.).
# Use http:// while the site is HTTP-only; switch to https:// after certbot.
# Production: https://penumbra-tech.com
APP_BASE_URL=http://YOUR_PUBLIC_IP

# ---- SMTP (optional) ------------------------------------------------------
# Leave SMTP_HOST blank to log outbound emails to the PM2 console instead of
# sending them. That lets the password-reset flow be tested end-to-end
# without needing real SMTP credentials yet.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# ---- Contact form ---------------------------------------------------------
# Where new /api/contact submissions trigger a notification email. If
# blank, the mailer falls back to SMTP_FROM. If both are blank no email
# goes out, but the row is still saved to the `contacts` table for later
# review via /api/admin/contacts.
CONTACT_NOTIFY_EMAIL=

# ---- Backend --------------------------------------------------------------
PORT=3000

# ---- Stripe ---------------------------------------------------------------
# Required for the /api/payments/* routes to work. While these are blank,
# the routes return 503 and the Subscribe page shows a "not configured" notice.
#
# Get all of these from https://dashboard.stripe.com/test/apikeys (test mode)
# until you're ready to go live. Test card: 4242 4242 4242 4242, any future
# expiry, any 3-digit CVC, any ZIP.
#
# STRIPE_PUBLISHABLE_KEY  — pk_test_* — sent to the React client (safe to expose)
# STRIPE_SECRET_KEY       — sk_test_* — server only, never commit
# STRIPE_PRICE_ID         — price_*   — the recurring Price for "Premium"
#                                       (create a Product + Price in the
#                                       Stripe dashboard first)
# STRIPE_WEBHOOK_SECRET   — whsec_*   — endpoint signing secret. Get this
#                                       after registering a webhook endpoint
#                                       in the Stripe dashboard pointing at
#                                       https://your-host/api/payments/webhook
#                                       Subscribe at minimum to:
#                                         customer.subscription.created
#                                         customer.subscription.updated
#                                         customer.subscription.deleted
#                                         invoice.payment_succeeded
#                                         invoice.payment_failed
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
